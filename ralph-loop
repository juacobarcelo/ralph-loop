#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RALPH_TMP=".ralph-tmp"
CONFIG="${CONFIG:-ralph-config.yaml}"
LOOP_DIR="${LOOP_DIR:-.}"
DOCKER_USER="$(id -u):$(id -g)"
SOURCE_EPOCH_CACHE=""

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log_info()  { echo -e "${GREEN}[ralph]${NC} $*"; }
log_warn()  { echo -e "${YELLOW}[ralph]${NC} $*"; }
log_error() { echo -e "${RED}[ralph]${NC} $*" >&2; }

get_docker_run_extra_args() {
    local context="$1"
    local engine="${2:-}"
    local config_file="$CONFIG"

    [[ -f "$config_file" ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0

    python3 - "$config_file" "$context" "$engine" <<'PY' 2>/dev/null || true
import sys
import yaml

config_path = sys.argv[1]
context = sys.argv[2]
engine = sys.argv[3] if len(sys.argv) > 3 else ""

try:
    with open(config_path, "r", encoding="utf-8") as handle:
        config = yaml.safe_load(handle) or {}
except Exception:  # noqa: BLE001
    sys.exit(0)

if not isinstance(config, dict):
    sys.exit(0)

section = config.get("docker_run_args")
if not isinstance(section, dict):
    sys.exit(0)

args: list[str] = []

def add_items(items):
    if not isinstance(items, list):
        return
    for item in items:
        if isinstance(item, str):
            normalized = item.strip()
            if normalized:
                args.append(normalized)

add_items(section.get("default"))

contexts = section.get("contexts")
if isinstance(contexts, dict):
    add_items(contexts.get(context))

engines = section.get("engines")
if isinstance(engines, dict) and engine:
    add_items(engines.get(engine))

deduped: list[str] = []
seen: set[str] = set()
for item in args:
    if item in seen:
        continue
    seen.add(item)
    deduped.append(item)

for arg in deduped:
    print(arg)
PY
}

prepare_auth_mount_staging_dir() {
    local source_path="$1"
    local mount_path="$2"
    local target_path="$3"
    local sanitized_mount
    local staging_dir

    sanitized_mount="$(printf '%s' "$mount_path" | sed 's#[^A-Za-z0-9._-]#_#g')"
    staging_dir="$PWD/$RALPH_TMP/auth-mounts/$sanitized_mount"

    rm -rf "$staging_dir"
    mkdir -p "$staging_dir"
    chmod 700 "$staging_dir"

    if [[ -d "$source_path" ]]; then
        cp -a "$source_path"/. "$staging_dir"/
    elif [[ -f "$source_path" ]]; then
        cp -a "$source_path" "$staging_dir/$(basename "$target_path")"
    else
        return 1
    fi

    printf '%s\n' "$staging_dir"
}

append_auth_mounts_from_json() {
    local json_file="$1"
    local jq_expr="$2"
    local engine="$3"
    local container_home="$4"
    local auth_mount_array_name="$5"
    local mount_entry mount_path target_path expanded container_target container_parent host_mount
    local -n auth_mount_array="$auth_mount_array_name"

    while IFS= read -r mount_entry; do
        mount_path="$(jq -r '.source // empty' <<<"$mount_entry")"
        target_path="$(jq -r '.target // empty' <<<"$mount_entry")"
        [[ -n "$mount_path" && -n "$target_path" ]] || continue

        expanded="${mount_path/#\~/$HOME}"
        if [[ ! -e "$expanded" ]]; then
            continue
        fi

        if [[ "$target_path" == "~/"* ]]; then
            container_target="${container_home}/${target_path:2}"
        else
            container_target="$target_path"
        fi

        host_mount="$(prepare_auth_mount_staging_dir "$expanded" "$mount_path" "$target_path")"
        if [[ -d "$expanded" ]]; then
            auth_mount_array+=("-v" "${host_mount}:${container_target}")
            continue
        fi

        container_parent="$(dirname "$container_target")"
        auth_mount_array+=("-v" "${host_mount}:${container_parent}")
    done < <(jq -c "$jq_expr" "$json_file")
}

cleanup() {
    rm -rf "$RALPH_TMP"
    exit "${1:-0}"
}
trap 'cleanup 130' INT TERM

ensure_image() {
    local target="$1"
    local image="ralph-loop-${target}"
    local should_build="0"
    local reason=""

    if [[ "${REBUILD_IMAGES:-0}" == "1" ]]; then
        should_build="1"
        reason="REBUILD_IMAGES=1"
    elif ! docker image inspect "$image" >/dev/null 2>&1; then
        should_build="1"
        reason="missing image"
    elif image_is_stale "$image"; then
        should_build="1"
        reason="source changed"
    fi

    if [[ "$should_build" == "1" ]]; then
        log_info "Building $image ($reason)..."
        local build_args=(--target "$target" -t "$image")
        if [[ "${RALPH_DOCKER_BUILD_QUIET:-0}" == "1" ]]; then
            build_args+=(--quiet)
        fi
        build_args+=("$SCRIPT_DIR")
        docker build "${build_args[@]}"
    fi
}

get_source_epoch() {
    if [[ -n "$SOURCE_EPOCH_CACHE" ]]; then
        echo "$SOURCE_EPOCH_CACHE"
        return
    fi

    local latest_epoch
    latest_epoch=$(
        {
            find "$SCRIPT_DIR/ralph_loop" "$SCRIPT_DIR/docker" -type f -printf '%T@\n' 2>/dev/null
            find "$SCRIPT_DIR" -maxdepth 1 -type f \
                \( -name "Dockerfile" -o -name "pyproject.toml" -o -name "ralph-loop" \) \
                -printf '%T@\n' 2>/dev/null
        } | sort -nr | head -1 | cut -d. -f1
    )

    if [[ -z "$latest_epoch" ]]; then
        latest_epoch=0
    fi

    SOURCE_EPOCH_CACHE="$latest_epoch"
    echo "$SOURCE_EPOCH_CACHE"
}

image_is_stale() {
    local image="$1"
    local created_iso
    local created_epoch
    local source_epoch

    created_iso=$(docker image inspect "$image" --format '{{.Created}}' 2>/dev/null || true)
    if [[ -z "$created_iso" ]]; then
        return 0
    fi

    created_epoch=$(date -d "$created_iso" +%s 2>/dev/null || echo 0)
    source_epoch=$(get_source_epoch)

    [[ "$source_epoch" -gt "$created_epoch" ]]
}

run_base() {
    local docker_extra=()
    mapfile -t docker_extra < <(get_docker_run_extra_args "base" "base")
    docker run --rm -u "$DOCKER_USER" -v "$PWD:/workspace" "${docker_extra[@]}" ralph-loop-base "$@"
}

run_cli() {
    local image="$1"; shift
    local auth_env=() auth_mount=()
    local container_home="/home/ralph"
    local action="${1:-execute}"
    local context="$action"
    local engine="${image#ralph-loop-}"
    local docker_extra=()

    case "$action" in
        execute) context="code" ;;
        inspect) context="inspect" ;;
    esac

    mapfile -t docker_extra < <(get_docker_run_extra_args "$context" "$engine")

    while IFS= read -r env_var; do
        [[ -n "${!env_var:-}" ]] && auth_env+=("-e" "$env_var")
    done < <(jq -r '.auth.env[]? // empty' "$RALPH_TMP/next-action.json")
    append_auth_mounts_from_json \
        "$RALPH_TMP/next-action.json" \
        '.auth.mount[]? // empty' \
        "$engine" \
        "$container_home" \
        auth_mount

    docker run --rm -u "$DOCKER_USER" -v "$PWD:/workspace" "${docker_extra[@]}" "${auth_env[@]}" "${auth_mount[@]}" "$image" "$@"
}

run_visual_cli() {
    local image="$1"; shift
    local auth_env=() auth_mount=()
    local container_home="/home/ralph"
    local engine="${image#ralph-loop-}"
    local docker_extra=()

    mapfile -t docker_extra < <(get_docker_run_extra_args "visual" "$engine")

    while IFS= read -r env_var; do
        [[ -n "${!env_var:-}" ]] && auth_env+=("-e" "$env_var")
    done < <(jq -r '.auth.env[]? // empty' "$RALPH_TMP/next-action.json")
    append_auth_mounts_from_json \
        "$RALPH_TMP/next-action.json" \
        '.auth.mount[]? // empty' \
        "$engine" \
        "$container_home" \
        auth_mount

    docker run --rm -u "$DOCKER_USER" \
        --add-host=host.docker.internal:host-gateway \
        -v "$PWD:/workspace" \
        "${docker_extra[@]}" \
        "${auth_env[@]}" "${auth_mount[@]}" "$image" "$@"
}

