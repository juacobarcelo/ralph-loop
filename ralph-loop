}

run_cli_with_auth_file() {
    local image="$1"; shift
    local auth_file="$1"; shift
    local auth_env=() auth_mount=()
    local container_home="/home/ralph"
    local action="${1:-init}"
    local context="$action"
    local engine="${image#ralph-loop-}"
    local docker_extra=()

    mapfile -t docker_extra < <(get_docker_run_extra_args "$context" "$engine")

    while IFS= read -r env_var; do
        [[ -n "${!env_var:-}" ]] && auth_env+=("-e" "$env_var")
    done < <(jq -r '.env[]? // empty' "$auth_file")
    append_auth_mounts_from_json \
        "$auth_file" \
        '.mount[]? // empty' \
        "$engine" \
        "$container_home" \
        auth_mount

    docker run --rm -u "$DOCKER_USER" -v "$PWD:/workspace" "${docker_extra[@]}" "${auth_env[@]}" "${auth_mount[@]}" "$image" "$@"
