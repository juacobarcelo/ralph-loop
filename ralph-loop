run_init_cli_with_auth_file() {
    local image="$1"; shift
    local auth_file="$1"; shift
    local loop_dir_host="$1"; shift
    local loop_dir_container="$1"; shift
    local plan_output_host="$1"; shift
    local plan_output_container="$1"; shift
    local args=("$@")
    local auth_env=() auth_mount=()
    local container_home="/home/ralph"
    local engine="${image#ralph-loop-}"
    local docker_extra=()
    local existing_plan_output
    local mount_plan_output=1
    local plan_output_mount=()

    mkdir -p "$PWD/$RALPH_TMP" "$loop_dir_host"

    mapfile -t docker_extra < <(get_docker_run_extra_args "init" "$engine")

    while IFS= read -r env_var; do
        [[ -n "${!env_var:-}" ]] && auth_env+=("-e" "$env_var")
    done < <(jq -r '.env[]? // empty' "$auth_file")
    append_auth_mounts_from_json \
        "$auth_file" \
        '.mount[]? // empty' \
        "$engine" \
        "$container_home" \
        auth_mount

    existing_plan_output="$(extract_cli_option_value "--plan-output-file" "${args[@]}")"
    if [[ -z "$existing_plan_output" ]]; then
        args+=("--plan-output-file" "$plan_output_container")
    fi

    case "$plan_output_host" in
        "$PWD/$RALPH_TMP"/*|"$loop_dir_host"/*)
            mount_plan_output=0
            ;;
    esac
    if [[ "$mount_plan_output" -eq 1 ]]; then
        plan_output_mount=(-v "$plan_output_host:$plan_output_container")
    fi

    docker run --rm -u "$DOCKER_USER" \
        --read-only \
        --tmpfs /tmp \
        --tmpfs /home/ralph/.cache \
        -v "$PWD:/workspace:ro" \
        -v "$PWD/$RALPH_TMP:/workspace/.ralph-tmp" \
        -v "$loop_dir_host:$loop_dir_container" \
        "${plan_output_mount[@]}" \
        "${docker_extra[@]}" \
        "${auth_env[@]}" "${auth_mount[@]}" \
        "$image" \
        "${args[@]}"
}

extract_init_backend_override() {
    local args=("$@")
    local index
    for ((index=0; index<${#args[@]}; index++)); do
        if [[ "${args[index]}" == "--backend" ]]; then
            if (( index + 1 < ${#args[@]} )); then
                echo "${args[index + 1]}"
                return
            fi
        fi
        if [[ "${args[index]}" == --backend=* ]]; then
            echo "${args[index]#--backend=}"
            return
        fi
    done
    echo ""
}

run_trusted_verify_cmd() {
    local cwd="$1"
    local cmd="$2"
    (
        cd "$cwd"
        bash -lc "$cmd"
    )
}

normalize_verify_cmd() {
    local cmd="$1"
    local workspace_raw="$2"
    local workspace_rel=""
    local prefixes=()

    if [[ "$workspace_raw" == /workspace/* ]]; then
        workspace_rel="${workspace_raw#/workspace/}"
    fi

    prefixes+=("cd $workspace_raw && " "cd \"$workspace_raw\" && " "cd '$workspace_raw' && ")

    if [[ -n "$workspace_rel" ]]; then
        prefixes+=(
            "cd $workspace_rel && "
            "cd ./$workspace_rel && "
            "cd \"$workspace_rel\" && "
            "cd \"./$workspace_rel\" && "
            "cd '$workspace_rel' && "
            "cd './$workspace_rel' && "
            "cd /workspace/$workspace_rel && "
        )
    fi

    for prefix in "${prefixes[@]}"; do
        if [[ "$cmd" == "$prefix"* ]]; then
            echo "${cmd#$prefix}"
            return
        fi
    done

    echo "$cmd"
}

container_path_to_host_path() {
    local path="$1"
    if [[ "$path" == "/workspace" ]]; then
        echo "$PWD"
        return
    fi
    if [[ "$path" == /workspace/* ]]; then
        echo "$PWD/${path#/workspace/}"
        return
    fi
    echo "$path"
}

resolve_host_path() {
    local raw_path="$1"
    python3 - "$raw_path" <<'PY'
import os
import sys

print(os.path.abspath(sys.argv[1]))
PY
}

host_path_to_container_path() {
    local raw_path="$1"
    local host_path
    host_path="$(resolve_host_path "$raw_path")"
    if [[ "$host_path" == "$PWD" ]]; then
        echo "/workspace"
        return
    fi
    if [[ "$host_path" == "$PWD/"* ]]; then
        echo "/workspace/${host_path#$PWD/}"
        return
    fi
    echo "$host_path"
}

extract_cli_option_value() {
    local option_name="$1"
    shift
    local args=("$@")
    local index
    for ((index=0; index<${#args[@]}; index++)); do
        if [[ "${args[index]}" == "$option_name" ]]; then
            if (( index + 1 < ${#args[@]} )); then
                echo "${args[index + 1]}"
                return
            fi
        fi
        if [[ "${args[index]}" == "$option_name="* ]]; then
            echo "${args[index]#${option_name}=}"
            return
        fi
    done
    echo ""
}

print_coder_prompt() {
    local prompt_file="$1"
    local prompt_file_host
    prompt_file_host=$(container_path_to_host_path "$prompt_file")

    if [[ ! -f "$prompt_file_host" ]]; then
        log_warn "Task $TASK_ID: coder prompt file not found: $prompt_file_host"
        return
    fi

    log_info "Task $TASK_ID: coder prompt file -> $prompt_file_host"
    echo "[ralph] ----- BEGIN CODER PROMPT (task: $TASK_ID) -----"
    cat "$prompt_file_host"
    echo "[ralph] ----- END CODER PROMPT (task: $TASK_ID) -----"
}

build_backend_args() {
    BACKEND_ARGS=()

    local model timeout
    model=$(jq -r '.model // empty' "$RALPH_TMP/next-action.json")
    timeout=$(jq -r '.timeout_seconds // empty' "$RALPH_TMP/next-action.json")

    [[ -n "$model" ]] && BACKEND_ARGS+=(--model "$model")
    [[ -n "$timeout" ]] && BACKEND_ARGS+=(--timeout-seconds "$timeout")

    while IFS= read -r extra_flag; do
        [[ -n "$extra_flag" ]] && BACKEND_ARGS+=(--extra-flag "$extra_flag")
    done < <(jq -r '.extra_flags[]? // empty' "$RALPH_TMP/next-action.json")
}

resolve_loop_dir_from_argument() {
    local loop_dir_input="$1"
    local normalized="${loop_dir_input%/}"
    local candidates=()
    local candidate_dirs=()
    local progress_path=""

    if [[ -z "$normalized" ]]; then
        normalized="$loop_dir_input"
    fi

    progress_path="$normalized/PROGRESS.yaml"
    if [[ -f "$progress_path" ]]; then
        LOOP_DIR="$normalized"
        return
    fi

    if [[ -d "$normalized" ]]; then
        while IFS= read -r found; do
            candidates+=("$found")
        done < <(find "$normalized" -mindepth 2 -maxdepth 2 -type f -name "PROGRESS.yaml" 2>/dev/null)

        if [[ ${#candidates[@]} -eq 1 ]]; then
            LOOP_DIR="$(dirname "${candidates[0]}")"
            log_warn "'$normalized' has no PROGRESS.yaml; auto-selected '$LOOP_DIR'"
            return
        fi

        if [[ ${#candidates[@]} -gt 1 ]]; then
            log_error "Loop dir '$normalized' is ambiguous (multiple plans found)."
            log_error "Use one of these specific loop directories:"
            for candidate in "${candidates[@]}"; do
                candidate_dirs+=("$(dirname "$candidate")")
            done
            for dir in "${candidate_dirs[@]}"; do
                log_error "  - $dir"
            done
            exit 1
        fi
    fi

    LOOP_DIR="$normalized"
}

cmd_run() {
    local args=("$@")
    if [[ ${#args[@]} -gt 0 && "${args[0]}" != -* ]]; then
        resolve_loop_dir_from_argument "${args[0]}"
        args=("${args[@]:1}")
    fi
    if [[ ${#args[@]} -gt 0 ]]; then
        log_error "Unknown arguments for run: ${args[*]}"
        exit 1
    fi

    ensure_image "base"
    for engine in $(run_base list-engines --config "/workspace/$CONFIG" 2>/dev/null); do
        ensure_image "$engine"
    done

    rm -rf "$RALPH_TMP"
    mkdir -p "$RALPH_TMP"
    log_info "Using config: $CONFIG"
    log_info "Using loop dir: $LOOP_DIR"
    log_info "Starting ralph loop..."

    while true; do
        run_base next-action --config "/workspace/$CONFIG" --loop-dir "/workspace/$LOOP_DIR" --step-result "/workspace/$RALPH_TMP/step-result.json" > "$RALPH_TMP/next-action.json"
        COMMAND=$(jq -r '.command' "$RALPH_TMP/next-action.json")
        TASK_ID=$(jq -r '.task_id // "n/a"' "$RALPH_TMP/next-action.json")
        log_info "Next action: $COMMAND (task: $TASK_ID)"

        case "$COMMAND" in
            orphan)
                TASK_IDS=$(jq -r '.task_ids[]? // empty' "$RALPH_TMP/next-action.json" | paste -sd ', ' -)
                [[ -z "$TASK_IDS" ]] && TASK_IDS="unknown"
                log_warn "Detected orphan in-progress tasks: $TASK_IDS"
                printf "[ralph] Recover orphan tasks and continue? [y/N]: "
                read -r RECOVER_ORPHAN
                if [[ "$RECOVER_ORPHAN" =~ ^([yY][eE][sS]|[yY])$ ]]; then
                    run_base recover --config "/workspace/$CONFIG" --loop-dir "/workspace/$LOOP_DIR" --task-id all >/dev/null
                    log_info "Recovered orphan tasks. Continuing loop..."
                    continue
                fi
                log_error "Loop aborted by user due to orphan in-progress tasks."
                cleanup 1
                ;;
            code)
                IMAGE=$(jq -r '.image' "$RALPH_TMP/next-action.json")
                PROMPT_FILE=$(jq -r '.prompt_file' "$RALPH_TMP/next-action.json")
                build_backend_args
                log_info "Task $TASK_ID: coding via $IMAGE..."
                print_coder_prompt "$PROMPT_FILE"
                set +e
                SECONDS=0
                run_cli "$IMAGE" execute \
                    --prompt-file "$PROMPT_FILE" \
                    "${BACKEND_ARGS[@]}"
                EXIT_CODE=$?
                DURATION=$SECONDS
                set -e
                log_info "Task $TASK_ID: code finished in ${DURATION}s (exit $EXIT_CODE)"
                jq -n --arg task "$TASK_ID" --argjson exit "$EXIT_CODE" --argjson dur "$DURATION" '{step:"code",task_id:$task,exit_code:$exit,duration_seconds:$dur}' > "$RALPH_TMP/step-result.json"
                ;;
            verify)
                log_info "Task $TASK_ID: running verification commands on host..."
                VERIFY_CWD_RAW=$(jq -r '.workspace_dir // "/workspace"' "$RALPH_TMP/next-action.json")
                VERIFY_CWD=$(container_path_to_host_path "$VERIFY_CWD_RAW")
                log_info "Task $TASK_ID: verify cwd -> $VERIFY_CWD"
                RESULTS="[]"
                while IFS= read -r cmd; do
                    EFFECTIVE_CMD=$(normalize_verify_cmd "$cmd" "$VERIFY_CWD_RAW")
                    if [[ "$EFFECTIVE_CMD" != "$cmd" ]]; then
                        log_info "Task $TASK_ID: normalized verify command -> $EFFECTIVE_CMD"
                    fi
                    log_info "Task $TASK_ID: verify command -> $EFFECTIVE_CMD"
                    VERIFY_STDOUT_FILE="$RALPH_TMP/verify-stdout.txt"
                    VERIFY_STDERR_FILE="$RALPH_TMP/verify-stderr.txt"
                    : > "$VERIFY_STDOUT_FILE"
                    : > "$VERIFY_STDERR_FILE"
                    set +e
                    run_trusted_verify_cmd "$VERIFY_CWD" "$EFFECTIVE_CMD" \
                        > >(tee "$VERIFY_STDOUT_FILE") \
                        2> >(tee "$VERIFY_STDERR_FILE" >&2)
                    CMD_EXIT=$?
                    set -e
                    STDOUT=$(cat "$VERIFY_STDOUT_FILE")
                    STDERR=$(cat "$VERIFY_STDERR_FILE")
                    OUTPUT="${STDOUT}"$'\n'"${STDERR}"
                    TRUNCATED=$(echo "$OUTPUT" | tail -c 4000)
                    RESULTS=$(echo "$RESULTS" | jq --arg cmd "$EFFECTIVE_CMD" --argjson exit "$CMD_EXIT" --arg out "$TRUNCATED" '. + [{command:$cmd,exit_code:$exit,stdout:$out,stderr:""}]')
                    log_info "Task $TASK_ID: verify command exit $CMD_EXIT"
                done < <(jq -r '.commands[]' "$RALPH_TMP/next-action.json")
                jq -n --arg task "$TASK_ID" --argjson results "$RESULTS" '{step:"verify",task_id:$task,results:$results}' > "$RALPH_TMP/step-result.json"
                ;;
            runtime)
                PHASE=$(jq -r '.phase // "unknown"' "$RALPH_TMP/next-action.json")
                STEP_NAME="runtime_${PHASE}"
                RUNTIME_COMMAND=$(jq -r '.runtime_command // empty' "$RALPH_TMP/next-action.json")
                RUNTIME_TIMEOUT=$(jq -r '.timeout_seconds // 180' "$RALPH_TMP/next-action.json")
                VERIFY_CWD_RAW=$(jq -r '.workspace_dir // "/workspace"' "$RALPH_TMP/next-action.json")
                VERIFY_CWD=$(container_path_to_host_path "$VERIFY_CWD_RAW")

                if [[ -z "$RUNTIME_COMMAND" ]]; then
                    log_warn "Task $TASK_ID: no runtime command configured for phase $PHASE"
                    jq -n --arg step "$STEP_NAME" --arg task "$TASK_ID" '{step:$step,task_id:$task,exit_code:0,stdout:"",stderr:"",runtime_command:""}' > "$RALPH_TMP/step-result.json"
                    continue
                fi

                log_info "Task $TASK_ID: runtime $PHASE check on host..."
                log_info "Task $TASK_ID: runtime cwd -> $VERIFY_CWD"
                log_info "Task $TASK_ID: runtime command -> $RUNTIME_COMMAND"
                RUNTIME_STDOUT_FILE="$RALPH_TMP/runtime-stdout.txt"
                RUNTIME_STDERR_FILE="$RALPH_TMP/runtime-stderr.txt"
                : > "$RUNTIME_STDOUT_FILE"
                : > "$RUNTIME_STDERR_FILE"

                set +e
                (
                    cd "$VERIFY_CWD"
                    timeout "${RUNTIME_TIMEOUT}"s bash -lc "$RUNTIME_COMMAND"
                ) > >(tee "$RUNTIME_STDOUT_FILE") \
                  2> >(tee "$RUNTIME_STDERR_FILE" >&2)
                EXIT_CODE=$?
                set -e
                STDOUT=$(cat "$RUNTIME_STDOUT_FILE")
                STDERR=$(cat "$RUNTIME_STDERR_FILE")
                log_info "Task $TASK_ID: runtime $PHASE finished (exit $EXIT_CODE)"
                jq -n \
                    --arg step "$STEP_NAME" \
                    --arg task "$TASK_ID" \
                    --arg phase "$PHASE" \
                    --arg cmd "$RUNTIME_COMMAND" \
                    --arg out "$STDOUT" \
                    --arg err "$STDERR" \
                    --argjson exit "$EXIT_CODE" \
                    '{step:$step,task_id:$task,phase:$phase,runtime_command:$cmd,exit_code:$exit,stdout:$out,stderr:$err}' \
                    > "$RALPH_TMP/step-result.json"
                ;;
            inspect)
                IMAGE=$(jq -r '.image' "$RALPH_TMP/next-action.json")
                build_backend_args
                log_info "Task $TASK_ID: AI inspection via $IMAGE..."
                INSPECT_STDOUT_FILE="$RALPH_TMP/inspect-stdout.txt"
                INSPECT_STDERR_FILE="$RALPH_TMP/inspect-stderr.txt"
                : > "$INSPECT_STDOUT_FILE"
                : > "$INSPECT_STDERR_FILE"
                set +e
                run_cli "$IMAGE" inspect \
                    --prompt-file "$(jq -r '.prompt_file' "$RALPH_TMP/next-action.json")" \
                    "${BACKEND_ARGS[@]}" \
                    > >(tee "$INSPECT_STDOUT_FILE") \
                    2> >(tee "$INSPECT_STDERR_FILE" >&2)
                EXIT_CODE=$?
                set -e
                STDOUT=$(cat "$INSPECT_STDOUT_FILE")
                log_info "Task $TASK_ID: inspect finished (exit $EXIT_CODE)"
                jq -n --arg task "$TASK_ID" --argjson exit "$EXIT_CODE" --arg out "$STDOUT" '{step:"inspect",task_id:$task,exit_code:$exit,stdout:$out}' > "$RALPH_TMP/step-result.json"
                ;;
            review)
                IMAGE=$(jq -r '.image' "$RALPH_TMP/next-action.json")
                build_backend_args
                log_info "Task $TASK_ID: unified review via $IMAGE..."
                REVIEW_STDOUT_FILE="$RALPH_TMP/review-stdout.txt"
                REVIEW_STDERR_FILE="$RALPH_TMP/review-stderr.txt"
                : > "$REVIEW_STDOUT_FILE"
                : > "$REVIEW_STDERR_FILE"
                set +e
                run_review_cli "$IMAGE" review \
                    --prompt-file "$(jq -r '.prompt_file' "$RALPH_TMP/next-action.json")" \
                    "${BACKEND_ARGS[@]}" \
                    > >(tee "$REVIEW_STDOUT_FILE") \
                    2> >(tee "$REVIEW_STDERR_FILE" >&2)
                EXIT_CODE=$?
                set -e
                STDOUT=$(cat "$REVIEW_STDOUT_FILE")
                STDERR=$(cat "$REVIEW_STDERR_FILE")
                log_info "Task $TASK_ID: review finished (exit $EXIT_CODE)"
                jq -n --arg task "$TASK_ID" --argjson exit "$EXIT_CODE" --arg out "$STDOUT" --arg err "$STDERR" '{step:"review",task_id:$task,exit_code:$exit,stdout:$out,stderr:$err}' > "$RALPH_TMP/step-result.json"
                ;;
            visual)
                IMAGE=$(jq -r '.image' "$RALPH_TMP/next-action.json")
                build_backend_args
                log_info "Task $TASK_ID: visual check via $IMAGE..."
                VISUAL_STDOUT_FILE="$RALPH_TMP/visual-stdout.txt"
                VISUAL_STDERR_FILE="$RALPH_TMP/visual-stderr.txt"
                : > "$VISUAL_STDOUT_FILE"
                : > "$VISUAL_STDERR_FILE"
                set +e
                run_visual_cli "$IMAGE" visual \
                    --config "/workspace/$CONFIG" \
                    --loop-dir "/workspace/$LOOP_DIR" \
                    --task-id "$TASK_ID" \
                    "${BACKEND_ARGS[@]}" \
                    > >(tee "$VISUAL_STDOUT_FILE") \
                    2> >(tee "$VISUAL_STDERR_FILE" >&2)
                EXIT_CODE=$?
                set -e
                STDOUT=$(cat "$VISUAL_STDOUT_FILE")
                log_info "Task $TASK_ID: visual finished (exit $EXIT_CODE)"
                jq -n --arg task "$TASK_ID" --argjson exit "$EXIT_CODE" --arg out "$STDOUT" '{step:"visual",task_id:$task,exit_code:$exit,stdout:$out}' > "$RALPH_TMP/step-result.json"
                ;;
            update)
                log_info "Task $TASK_ID: updating progress..."
                run_base update --config "/workspace/$CONFIG" --loop-dir "/workspace/$LOOP_DIR" --result-dir "/workspace/$RALPH_TMP/"
                ;;
            done)
                REASON=$(jq -r '.reason // "all_completed"' "$RALPH_TMP/next-action.json")
                log_info "Loop complete: $REASON"
                cleanup 0
                ;;
            abort)
                REASON=$(jq -r '.reason // "max_retries_reached"' "$RALPH_TMP/next-action.json")
                log_error "Task $TASK_ID aborted: $REASON"
                cleanup 1
                ;;
            pause)
                log_warn "Paused - remove PAUSE.md to resume."
                sleep 30
                ;;
            *)
                log_error "Unknown command: $COMMAND"
                cleanup 1
                ;;
        esac
    done
}

cmd_status() {
    local args=("$@")
    if [[ ${#args[@]} -gt 0 && "${args[0]}" != -* ]]; then
        resolve_loop_dir_from_argument "${args[0]}"
        args=("${args[@]:1}")
    fi
    if [[ ${#args[@]} -gt 0 ]]; then
        log_error "Unknown arguments for status: ${args[*]}"
        exit 1
    fi

    ensure_image "base"
    run_base status --config "/workspace/$CONFIG" --loop-dir "/workspace/$LOOP_DIR"
}

cmd_init() {
    local args=("$@")
    local source_arg
    local loop_dir_host loop_dir_container
    local plan_output_arg plan_output_host plan_output_container
    ensure_image "base"

    source_arg="$(extract_cli_option_value "--from" "${args[@]}")"
    if [[ -z "$source_arg" ]]; then
        log_error "init requires --from <source-plan>"
        exit 1
    fi

    plan_output_arg="$(extract_cli_option_value "--plan-output-file" "${args[@]}")"
    if [[ -n "$plan_output_arg" ]]; then
        plan_output_host="$(resolve_host_path "$plan_output_arg")"
        plan_output_container="$(host_path_to_container_path "$plan_output_host")"
    else
        plan_output_host="$PWD/$RALPH_TMP/generated-plan.json"
        plan_output_container="/workspace/$RALPH_TMP/generated-plan.json"
    fi

    loop_dir_host="$(dirname "$(resolve_host_path "$source_arg")")/.ralph-loop"
    loop_dir_container="$(host_path_to_container_path "$loop_dir_host")"

    local engine
    engine=$(extract_init_backend_override "${args[@]}")
    if [[ -z "$engine" ]]; then
        engine=$(run_base init-engine --config "/workspace/$CONFIG")
    fi

    case "$engine" in
        codex|copilot|claude) ;;
        *)
            log_error "Unsupported backend for init: $engine"
            exit 1
            ;;
    esac

    ensure_image "$engine"

    mkdir -p "$RALPH_TMP"
    mkdir -p "$loop_dir_host"
    mkdir -p "$(dirname "$plan_output_host")"
    : > "$plan_output_host"
    local auth_file="$RALPH_TMP/init-auth.json"
    run_base auth-config --engine "$engine" --config "/workspace/$CONFIG" > "$auth_file"

    log_info "Running init with backend image: ralph-loop-$engine"
    run_init_cli_with_auth_file \
        "ralph-loop-$engine" \
        "$auth_file" \
        "$loop_dir_host" \
        "$loop_dir_container" \
        "$plan_output_host" \
        "$plan_output_container" \
        init --config "/workspace/$CONFIG" "${args[@]}"
}

cmd_validate() {
    local args=("$@")
    if [[ ${#args[@]} -gt 0 && "${args[0]}" != -* ]]; then
        resolve_loop_dir_from_argument "${args[0]}"
        args=("${args[@]:1}")
    fi
    if [[ ${#args[@]} -gt 0 ]]; then
        log_error "Unknown arguments for validate: ${args[*]}"
        exit 1
    fi

    ensure_image "base"
    run_base validate --config "/workspace/$CONFIG" --loop-dir "/workspace/$LOOP_DIR"
}

cmd_check() {
    local args=("$@")
    if [[ ${#args[@]} -gt 0 && "${args[0]}" != -* ]]; then
        resolve_loop_dir_from_argument "${args[0]}"
        args=("${args[@]:1}")
    fi
    if [[ ${#args[@]} -gt 0 ]]; then
        log_error "Unknown arguments for check: ${args[*]}"
        exit 1
    fi

    ensure_image "base"
    run_base check --config "/workspace/$CONFIG" --loop-dir "/workspace/$LOOP_DIR"
}

cmd_build_images() {
    for target in base codex copilot claude; do
        ensure_image "$target"
    done
    log_info "All images built"
}

SUBCOMMAND="${1:-help}"; shift || true
case "$SUBCOMMAND" in
    run) cmd_run "$@" ;;
    status) cmd_status "$@" ;;
    init) cmd_init "$@" ;;
    validate) cmd_validate "$@" ;;
    check) cmd_check "$@" ;;
    build-images) cmd_build_images "$@" ;;
    help|--help|-h)
        echo "Usage: ralph-loop <run|status|init|validate|check|build-images>"
        echo "  run [LOOP_DIR]"
        echo "  status [LOOP_DIR]"
        echo "  validate [LOOP_DIR]"
        echo "  check [LOOP_DIR]"
        echo "  init [args...]"
        ;;
    *)
        log_error "Unknown command: $SUBCOMMAND"
        exit 1
        ;;
esac
